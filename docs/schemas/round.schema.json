{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tylerxia8/photo-snipe/schemas/round.schema.json",
  "title": "PhotoSnipe Round",
  "type": "object",
  "required": ["id", "name", "building", "spawns", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug identifier for the round"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name shown between rounds"
    },
    "building": {
      "type": "object",
      "required": ["id", "scene"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the 3D scene asset (GLB or engine scene)"
        }
      }
    },
    "spawns": {
      "type": "object",
      "required": ["playerA", "playerB"],
      "additionalProperties": false,
      "description": "Opposite-end spawn points inside the same building",
      "properties": {
        "playerA": { "$ref": "#/$defs/spawn" },
        "playerB": { "$ref": "#/$defs/spawn" }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "roundTimeLimitSec",
        "photoCooldownSec",
        "maxPhotoDistance",
        "minPhotoDistance"
      ],
      "additionalProperties": false,
      "properties": {
        "roundTimeLimitSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "photoCooldownSec": {
          "type": "number",
          "minimum": 0
        },
        "maxPhotoDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minPhotoDistance": {
          "type": "number",
          "minimum": 0
        },
        "requireAimMode": {
          "type": "boolean",
          "default": true
        },
        "requireFaceInFrame": {
          "type": "boolean",
          "default": true,
          "description": "Opponent face hit volume must be inside camera frustum"
        },
        "exposure": {
          "type": "object",
          "required": ["flash", "sound", "soundAudibleRadius", "flashVisibleRadius", "flashDurationSec"],
          "additionalProperties": false,
          "description": "Flash and sound emitted on every photo attempt",
          "properties": {
            "flash": {
              "type": "boolean"
            },
            "sound": {
              "type": "boolean"
            },
            "soundAudibleRadius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Meters within which opponent hears shutter sound"
            },
            "flashVisibleRadius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Meters within which opponent can see flash (with line of sight)"
            },
            "flashDurationSec": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Duration of visible flash effect"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spawn": {
      "type": "object",
      "required": ["position", "rotation"],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" },
          "description": "World-space spawn position [x, y, z]"
        },
        "rotation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" },
          "description": "Euler rotation in degrees [x, y, z]"
        }
      }
    }
  }
}
