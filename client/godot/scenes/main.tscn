[gd_scene load_steps=3 format=3 uid="uid://photosnipe_main"]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="1_lobby"]
[ext_resource type="PackedScene" uid="uid://photosnipe_game" path="res://scenes/game.tscn" id="2_game"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")
game_scene = ExtResource("2_game")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -120.0
offset_right = 180.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "PhotoSnipe"
horizontal_alignment = 1

[node name="NameInput" type="LineEdit" parent="Panel/VBox"]
layout_mode = 2
placeholder_text = "Display name"

[node name="RoomCodeInput" type="LineEdit" parent="Panel/VBox"]
layout_mode = 2
placeholder_text = "Room code (to join)"

[node name="CreateButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Create Room"

[node name="JoinButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Join Room"

[node name="StatusLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "Connecting..."
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="Panel/VBox/CreateButton" to="." method="_on_create_pressed"]
[connection signal="pressed" from="Panel/VBox/JoinButton" to="." method="_on_join_pressed"]
